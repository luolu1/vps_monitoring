{
  "manifest_version": 3,
  "name": "Outlook Auto Login Tester",
  "version": "0.1.0",
  "description": "Open Outlook in incognito and auto-fill login form for testing.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "windows"
  ],
  "host_permissions": [
    "https://login.live.com/*",
    "https://outlook.live.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Outlook Auto Login"
  },
  "content_scripts": [
    {
      "matches": [
        "https://login.live.com/*",
        "https://outlook.live.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
