<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/><title>屏蔽商品</title><%- include('partials-admin-style') %></head><body><div class="layout"><%- include('partials-admin-nav',{user, adminBase}) %><main class="main"><section class="panel"><h2>屏蔽商品</h2><form method="get" action="<%= adminBase %>/blocked-products" style="margin-bottom:10px;"><div class="grid"><div><label>选择商家</label><select name="siteId" onchange="this.form.submit()"><option value="">请选择</option><% sites.forEach((s)=>{ %><option value="<%= s.id %>" <%= selectedSiteId===s.id?'selected':'' %>><%= s.name %></option><% }) %></select></div></div></form><% if(selectedSiteId){ %><form method="post" action="<%= adminBase %>/blocked-products"><input type="hidden" name="siteId" value="<%= selectedSiteId %>"/><table><thead><tr><th>屏蔽</th><th>库存标题</th><th>库存</th><th>价格</th><th>更新时间</th></tr></thead><tbody><% if(!items.length){ %><tr><td colspan="5">该商家暂无库存</td></tr><% } %><% items.forEach((it)=>{ const key=String(it.title||'').trim(); %><tr><td><input type="checkbox" name="blockedTitles" value="<%= key %>" <%= blockedSet.has(key)?'checked':'' %>/></td><td><%= it.title %></td><td><%= it.in_stock? '有货':'无货' %></td><td><%= it.price %></td><td><%= it.last_seen_at %></td></tr><% }) %></tbody></table><div style="margin-top:10px;"><button type="submit">保存屏蔽设置</button></div></form><% } else { %><div class="muted">请先选择商家，再勾选要屏蔽的库存标题。</div><% } %></section></main></div></body></html>
