<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/><title>屏蔽商品</title><%- include('partials-admin-style') %></head><body><div class="layout"><%- include('partials-admin-nav',{user, adminBase}) %><main class="main"><section class="panel"><div class="section-head"><h2>屏蔽商品</h2><span class="muted">点击商家卡片后直接展示该商家的产品</span></div><div class="card-list"><% if(!sites.length){ %><div class="muted">暂无站点</div><% } %><% sites.forEach((site)=>{ const siteItems=siteItemsMap.get(site.id) || []; const blockedSet=blockedMap.get(site.id) || new Set(); const inStockCount=siteItems.filter((it)=>it.in_stock).length; %><details class="card"><summary><div class="section-head" style="margin:0;"><strong><%= site.name %></strong><div class="inline-form"><span class="pill">有货 <%= inStockCount %></span><span class="pill">总数 <%= siteItems.length %></span></div></div></summary><div style="margin-top:10px;"><form method="post" action="<%= adminBase %>/blocked-products"><input type="hidden" name="siteId" value="<%= site.id %>"/><table><thead><tr><th>屏蔽</th><th>库存标题</th><th>库存</th><th>价格</th><th>更新时间</th></tr></thead><tbody><% if(!siteItems.length){ %><tr><td colspan="5">该商家暂无库存</td></tr><% } %><% siteItems.forEach((it)=>{ const key=String(it.title||'').trim(); %><tr><td><input type="checkbox" name="blockedTitles" value="<%= key %>" <%= blockedSet.has(key)?'checked':'' %>/></td><td><%= it.title %></td><td class="<%= it.in_stock ? 'ok' : 'bad' %>"><%= it.in_stock? '有货':'无货' %></td><td><%= it.price %></td><td><%= it.last_seen_at %></td></tr><% }) %></tbody></table><div style="margin-top:10px;"><button type="submit">保存屏蔽设置</button></div></form></div></details><% }) %></div></section></main></div></body></html>
