<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/><title>站点管理</title><%- include('partials-admin-style') %></head><body><div class="layout"><%- include('partials-admin-nav',{user}) %><main class="main"><section class="panel"><h2>添加监控站点</h2><form method="post" action="/admin/sites"><div class="grid"><div><label>站点名称</label><input name="name" required/></div><div><label>监控URL / AFF链接</label><input name="url" required/></div><div><label>站点架构</label><select name="parserType"><option value="whmcs" selected>WHMCS</option></select></div><div><label><input type="checkbox" name="enabled" checked/> 启用监控</label></div><div><label><input type="checkbox" name="autoEnabled" checked/> 自动检测</label></div><div><label>间隔（分钟）</label><input type="number" name="checkIntervalMinutes" min="1" value="5" required/></div><div><label>超时（毫秒）</label><input type="number" name="requestTimeoutMs" min="3000" value="20000" required/></div><div><label>重试次数</label><input type="number" name="retryCount" min="0" value="2" required/></div><div><label>抓取模式</label><select name="fetchMode"><option value="http">HTTP</option><option value="browser">Browser</option></select></div><div><label>CF等待（毫秒）</label><input type="number" name="cfWaitMs" min="3000" value="7000" required/></div></div><div style="margin-top:10px"><button type="submit">保存站点</button></div></form></section><section class="panel"><h2>站点列表</h2><table><thead><tr><th>ID</th><th>名称</th><th>入口链接</th><th>架构</th><th>状态</th><th>自动</th><th>间隔</th><th>抓取</th><th>上次同步</th><th>操作</th></tr></thead><tbody><% if(!sites.length){ %><tr><td colspan="10">暂无站点</td></tr><% } %><% sites.forEach((s)=>{ %><tr><td><%= s.id %></td><td><%= s.name %></td><td><%= s.url %></td><td><%= (s.parser_type||'whmcs').toUpperCase() %></td><td class="<%= s.enabled?'ok':'bad' %>"><%= s.enabled?'启用':'禁用' %></td><td class="<%= s.auto_enabled?'ok':'bad' %>"><%= s.auto_enabled?'开启':'关闭' %></td><td><%= s.check_interval_minutes %>分钟</td><td><%= s.fetch_mode==='browser'?'Browser':'HTTP' %></td><td><%= s.last_sync_at||'-' %></td><td><form method="post" action="/admin/sites/<%= s.id %>/toggle" style="display:inline-block"><button type="submit"><%= s.enabled?'禁用':'启用' %></button></form> <form method="post" action="/admin/sites/<%= s.id %>/toggle-auto" style="display:inline-block"><button type="submit"><%= s.auto_enabled?'关自动':'开自动' %></button></form> <form method="post" action="/admin/sites/<%= s.id %>/run-once" style="display:inline-block"><button type="submit">手动检测</button></form> <a class="btn" href="/admin/sites/<%= s.id %>/edit">编辑</a> <a class="btn" href="/admin/inventory/<%= s.id %>">库存明细</a> <form method="post" action="/admin/sites/<%= s.id %>/delete" style="display:inline-block" onsubmit="return confirm('确认移除?')"><button class="btn-danger" type="submit">移除</button></form></td></tr><% }) %></tbody></table></section></main></div></body></html>
