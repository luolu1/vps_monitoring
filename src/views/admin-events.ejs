<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/><title>最近事件</title><%- include('partials-admin-style') %></head><body><div class="layout"><%- include('partials-admin-nav',{user}) %><main class="main"><section class="panel"><h2>最近事件</h2><table><thead><tr><th>时间</th><th>站点</th><th>项目</th><th>事件</th><th>变化</th></tr></thead><tbody><% if(!events.length){ %><tr><td colspan="5">暂无事件</td></tr><% } %><% events.forEach((e)=>{ %><tr><td><%= e.created_at %></td><td><%= e.site_name||'-' %></td><td><%= e.title %></td><td><%= e.event_type %></td><td><%= e.old_stock %> -> <%= e.new_stock %></td></tr><% }) %></tbody></table></section></main></div></body></html>
