<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/><title>系统设置</title><%- include('partials-admin-style') %></head><body><div class="layout"><%- include('partials-admin-nav',{user}) %><main class="main"><section class="panel"><h2>系统设置 - 管理员账号</h2><form method="post" action="/admin/account"><div class="grid"><div><label>用户名</label><input name="username" value="<%= user.username %>" required/></div><div><label>新密码（留空不改）</label><input type="password" name="password"/></div></div><% if(accountError){ %><div class="muted" style="color:#b42318;margin-top:8px"><%= accountError %></div><% } %><% if(accountSuccess){ %><div class="muted" style="color:#147a48;margin-top:8px"><%= accountSuccess %></div><% } %><div style="margin-top:10px"><button type="submit">更新账号</button></div></form></section><section class="panel"><h2>系统设置 - 前台展示 & 通知</h2><form method="post" action="/admin/settings"><div class="grid"><div><label>前台名称</label><input name="publicTitle" value="<%= settings.public_title %>" required/></div><div><label>前台背景图链接</label><input name="publicBackgroundImage" placeholder="https://example.com/bg.jpg" value="<%= settings.public_background_image || '' %>"/></div><div><label>Telegram Bot Token</label><input name="telegramBotToken" value="<%= settings.telegram_bot_token || '' %>" placeholder="123456:ABC..."/></div><div><label>Telegram Chat ID</label><input name="telegramChatId" value="<%= settings.telegram_chat_id || '' %>" placeholder="-100123456"/></div></div><% if(settingsSuccess){ %><div class="muted" style="color:#147a48;margin-top:8px"><%= settingsSuccess %></div><% } %><div style="margin-top:10px"><button type="submit">保存前台设置</button></div></form></section></main></div></body></html>
