<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>系统设置</title>
  <%- include('partials-admin-style') %>
</head>
<body>
  <div class="layout">
    <%- include('partials-admin-nav',{user, adminBase}) %>
    <main class="main">
      <section class="panel">
        <h2>系统设置 - 管理员账号</h2>
        <form method="post" action="<%= adminBase %>/account">
          <div class="grid">
            <div><label>用户名</label><input name="username" value="<%= user.username %>" required/></div>
            <div><label>新密码（留空不改）</label><input type="password" name="password"/></div>
          </div>
          <% if(accountError){ %><div class="muted" style="color:#b42318;margin-top:8px"><%= accountError %></div><% } %>
          <% if(accountSuccess){ %><div class="muted" style="color:#147a48;margin-top:8px"><%= accountSuccess %></div><% } %>
          <div style="margin-top:10px"><button type="submit">更新账号</button></div>
        </form>
      </section>

      <section class="panel">
        <h2>系统设置 - 前台展示 & 通知</h2>
        <form method="post" action="<%= adminBase %>/settings">
          <div class="grid">
            <div><label>后台路径（不含斜杠）</label><input name="adminPath" value="<%= settings.admin_path || 'admin' %>" required/></div>
            <div><label>前台名称</label><input name="publicTitle" value="<%= settings.public_title %>" required/></div>
            <div><label>前台背景图链接</label><input name="publicBackgroundImage" placeholder="https://example.com/bg.jpg" value="<%= settings.public_background_image || '' %>"/></div>
            <div><label>前台访问地址</label><input name="publicBaseUrl" placeholder="https://aa.test.com 或 http://IP:3000" value="<%= settings.public_base_url || '' %>"/></div>
            <div><label>Telegram Bot Token</label><input name="telegramBotToken" value="<%= settings.telegram_bot_token || '' %>" placeholder="123456:ABC..."/></div>
            <div><label>补货通知频道 Chat ID</label><input name="telegramRestockChatId" value="<%= settings.telegram_restock_chat_id || '' %>" placeholder="-100123456"/></div>
            <div><label>自动同步并发数</label><input type="number" min="1" max="30" name="monitorConcurrency" value="<%= settings.monitor_concurrency || 5 %>" required/></div>
            <div><label>空闲等待毫秒</label><input type="number" min="1000" max="60000" step="1000" name="monitorIdleDelayMs" value="<%= settings.monitor_idle_delay_ms || 3000 %>" required/></div>
            <div><label>单站点超时毫秒（0=自动估算）</label><input type="number" min="0" max="3600000" step="1000" name="monitorSiteTimeoutMs" value="<%= settings.monitor_site_timeout_ms || 0 %>" required/></div>
          </div>
          <% if(settingsError){ %><div class="muted" style="color:#b42318;margin-top:8px"><%= settingsError %></div><% } %>
          <% if(settingsSuccess){ %><div class="muted" style="color:#147a48;margin-top:8px"><%= settingsSuccess %></div><% } %>
          <div style="margin-top:10px"><button type="submit">保存设置</button></div>
        </form>
      </section>
    </main>
  </div>
</body>
</html>
