<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/><title>产品标签</title><%- include('partials-admin-style') %></head><body><div class="layout"><%- include('partials-admin-nav',{user, adminBase}) %><main class="main"><section class="panel"><div class="section-head"><h2>标签列表</h2><button type="button" class="btn" onclick="toggleAddTagModal(true)">新增标签</button></div><div class="card-list"><% if(!tags.length){ %><div class="muted">暂无标签</div><% } %><% tags.forEach((tag)=>{ %><details class="card"><summary><div class="section-head" style="margin:0;"><strong><%= tag.name %></strong><div class="inline-form"><a class="btn" href="<%= adminBase %>/product-tags/<%= tag.id %>/edit">编辑</a><form method="post" action="<%= adminBase %>/product-tags/<%= tag.id %>/delete" onsubmit="return confirm('确认删除该标签？')"><button type="submit">移除</button></form></div></div></summary><div style="margin-top:10px;"><% if(!tag.items || !tag.items.length){ %><div class="muted">该标签下暂无产品</div><% } else { const groups = {}; tag.items.forEach((item)=>{ if(!groups[item.site_name]) groups[item.site_name]=[]; groups[item.site_name].push(item); }); Object.keys(groups).forEach((siteName)=>{ const rows=groups[siteName]; const inStockCount=rows.filter((item)=>item.in_stock).length; %><details class="card" style="margin-top:8px;"><summary><div class="section-head" style="margin:0;"><span><%= siteName %></span><div class="inline-form"><span class="pill">有货 <%= inStockCount %></span><span class="pill">总数 <%= rows.length %></span></div></div></summary><div style="margin-top:8px;"><table><thead><tr><th>产品</th><th>库存</th><th>价格</th><th>更新时间</th></tr></thead><tbody><% rows.forEach((item)=>{ %><tr><td><%= item.title %></td><td class="<%= item.in_stock ? 'ok' : 'bad' %>"><%= item.in_stock ? '有货' : '无货' %></td><td><%= item.price || '-' %></td><td><%= item.last_seen_at || '-' %></td></tr><% }) %></tbody></table></div></details><% }) } %></div></details><% }) %></div></section></main></div><div id="addTagModal" class="modal-backdrop" onclick="if(event.target===this) toggleAddTagModal(false)"><div class="modal"><div class="section-head"><h2>新增标签</h2><button type="button" class="btn" onclick="toggleAddTagModal(false)">关闭</button></div><form method="post" action="<%= adminBase %>/product-tags"><div class="grid"><div><label>标签名称</label><input name="name" placeholder="如：国内优化" required/></div></div><div style="margin-top:10px;"><button type="submit">保存标签</button></div></form></div></div><script>function toggleAddTagModal(open){var el=document.getElementById('addTagModal'); if(!el) return; el.classList.toggle('open', !!open);}</script></body></html>
