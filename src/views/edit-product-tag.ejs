<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/><title>编辑标签</title><%- include('partials-admin-style') %></head><body><div class="layout"><%- include('partials-admin-nav',{user, adminBase}) %><main class="main"><section class="panel"><div class="section-head"><h2>编辑标签</h2><a class="btn" href="<%= adminBase %>/product-tags">关闭</a></div><form method="get" action="<%= adminBase %>/product-tags/<%= tag.id %>/edit" style="margin-bottom:10px;"><div class="grid"><div><label>标签名称</label><input value="<%= tag.name %>" disabled/></div><div><label>选择商家</label><select name="siteId" onchange="this.form.submit()"><option value="">请选择</option><% sites.forEach((s)=>{ %><option value="<%= s.id %>" <%= selectedSiteId===s.id?'selected':'' %>><%= s.name %></option><% }) %></select></div></div></form><form method="post" action="<%= adminBase %>/product-tags/<%= tag.id %>/edit"><input type="hidden" name="siteId" value="<%= selectedSiteId %>"/><div class="grid"><div><label>标签名称</label><input name="name" value="<%= tag.name %>" required/></div></div><% if(selectedSiteId){ %><table style="margin-top:10px;"><thead><tr><th>勾选</th><th>库存标题</th><th>库存</th><th>价格</th><th>更新时间</th></tr></thead><tbody><% if(!items.length){ %><tr><td colspan="5">该商家暂无库存</td></tr><% } %><% items.forEach((it)=>{ const key=String(it.title||'').trim(); %><tr><td><input type="checkbox" name="selectedTitles" value="<%= key %>" <%= taggedSet.has(key)?'checked':'' %>/></td><td><%= it.title %></td><td><%= it.in_stock? '有货':'无货' %></td><td><%= it.price %></td><td><%= it.last_seen_at %></td></tr><% }) %></tbody></table><% } else { %><div class="muted" style="margin-top:10px;">请选择商家后再勾选产品。</div><% } %><div style="margin-top:10px;"><button type="submit">保存标签</button></div></form></section></main></div></body></html>
