<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/><title>国家词典</title><%- include('partials-admin-style') %></head><body><div class="layout"><%- include('partials-admin-nav',{user, adminBase}) %><main class="main"><section class="panel"><h2>国家识别词典（自学习）</h2><form method="post" action="<%= adminBase %>/country-rules"><div class="grid"><div><label>国家名称</label><input name="country" required/></div><div><label>关键词</label><input name="keyword" required/></div></div><div style="margin-top:10px"><button type="submit">添加规则</button></div></form><h3 style="margin-top:12px">已生效规则</h3><table><thead><tr><th>ID</th><th>国家</th><th>关键词</th><th>操作</th></tr></thead><tbody><% if(!countryRules.length){ %><tr><td colspan="4">暂无规则</td></tr><% } %><% countryRules.forEach((r)=>{ %><tr><td><%= r.id %></td><td><form method="post" action="<%= adminBase %>/country-rules/<%= r.id %>/edit"><input name="country" value="<%= r.country %>" required/></td><td><input name="keyword" value="<%= r.keyword %>" required/></td><td><button type="submit">保存</button></form> <form method="post" action="<%= adminBase %>/country-rules/<%= r.id %>/delete" style="display:inline-block"><button class="btn-danger" type="submit">删除</button></form></td></tr><% }) %></tbody></table><h3 style="margin-top:12px">待学习关键词</h3><table><thead><tr><th>关键词</th><th>次数</th><th>样例标题</th></tr></thead><tbody><% if(!unknownHints.length){ %><tr><td colspan="3">暂无</td></tr><% } %><% unknownHints.slice(0,30).forEach((h)=>{ %><tr><td><%= h.token %></td><td><%= h.count %></td><td><%= h.sample_title||'-' %></td></tr><% }) %></tbody></table></section></main></div></body></html>
